## Input/Output File names
##******************************************************

# input or output ScW file (mandatory)
#--------------------------------------------------
create_scw_file,i,h,1,0,1,"Create (1) or read (0) from the specified ScW file"
scw_file,s,h,"scw.fits.gz",,,"Name of the fits ScW input/output file"
